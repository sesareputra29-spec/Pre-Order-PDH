# ==============================================================================
# PDH CAMPUS ORDER - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi `.env` di lingkungan lokal atau set di Vercel Dashboard.
# JANGAN pernah menyimpan credential/API key asli dalam repository ini.

# ------------------------------------------------------------------------------
# 1. REQUIRED PRODUCTION CONFIGURATION
# ------------------------------------------------------------------------------
# Kunci rahasia untuk enkripsi dan penandatanganan JWT Token login/sesi
JWT_SECRET="ganti_dengan_random_jwt_secret_panjang_dan_aman_32_karakter"

# Service Account Google Cloud (Memiliki akses Editor ke Spreadsheet & Root Folder Drive)
GOOGLE_PROJECT_ID="pdh-campus-order-project-id"
GOOGLE_CLIENT_EMAIL="pdh-service-account@pdh-campus-order-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Provider Email Transaksional (Resend API Key)
RESEND_API_KEY="re_1234567890_abcdefghijklmnopqrstuvwxyz"
EMAIL_FROM="PDH Campus Order <no-reply@prodi-manajemen-campus.ac.id>"

# Base URL Aplikasi (Digunakan untuk tautan verifikasi email & reset password)
APP_BASE_URL="https://pdh-order.prodi-manajemen.ac.id"

# Konfigurasi Master Tenant Baseline (Prodi 1)
DEFAULT_TENANT_ID="TENANT-001"
TENANT_001_NAMA_UNIVERSITAS="Universitas Terbuka / Kampus Nasional"
TENANT_001_NAMA_FAKULTAS="Fakultas Ekonomi dan Bisnis"
TENANT_001_NAMA_PRODI="Manajemen"
TENANT_001_KODE_PRODI="MJSP"
TENANT_001_SPREADSHEET_ID="1SpreadsheetIdPDHCampusOrderDatabase2026"
TENANT_001_DRIVE_ROOT_ID="1DriveRootFolderPDH2026"

# ------------------------------------------------------------------------------
# 2. OPTIONAL CONFIGURATION (Multi-Tenant & Cache TTL)
# ------------------------------------------------------------------------------
# Konfigurasi Tenant Tambahan (Prodi 2 - Opsional)
TENANT_002_NAMA_UNIVERSITAS="Universitas Terbuka / Kampus Nasional"
TENANT_002_NAMA_FAKULTAS="Fakultas Ekonomi dan Bisnis"
TENANT_002_NAMA_PRODI="Akuntansi"
TENANT_002_KODE_PRODI="AKSP"
TENANT_002_SPREADSHEET_ID="1SpreadsheetIdPDHCampusOrderDatabase2026_Akuntansi"
TENANT_002_DRIVE_ROOT_ID="1DriveRootFolderPDH2026_Akuntansi"

# Pengaturan TTL Cache In-Memory (dalam milidetik - Opsional)
CACHE_TTL_CONFIG_MS=30000
CACHE_TTL_PDH_MS=30000
CACHE_TTL_PERIOD_MS=30000
CACHE_TTL_USER_MS=10000
CACHE_TTL_STUDENT_MS=10000
CACHE_TTL_ORDER_MS=10000
CACHE_TTL_PAYMENT_MS=10000
CACHE_TTL_PRODUCTION_MS=10000
CACHE_TTL_NOTIFICATION_MS=5000
CACHE_TTL_AUTH_MS=5000

# ------------------------------------------------------------------------------
# 3. DEVELOPMENT / LOCAL TEST CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
